   "source": [
    "# This code is for signal processing for a magnetometer. \n",
    "# It aims to output the residual values of M and m_i where M = SUM(m_i) / V\n",
    "# It is modified for the data collected on WEEK 9 25 September 2026\n",
    "# It will take as input 1 csv file named SDS00001.CSV with the structure:\n",
    "#\n",
    "# Time(s) | CH1 (V) | CH2 (V) \n",
    "# \n",
    "# There are some junk columns to the left which will be omitted later\n",
    "# \n",
    "# Where:\n",
    "# - CH1 is the raw pickup coil voltage\n",
    "# - CH2 is the raw voltage powering an electromagnet coil (measured accross a resistor in series)\n",
    "# - Time is just the time associated with each signal\n",
    "#\n",
    "# If the CSV outputted isnt of this form, the csv should be changed.\n",
    "#\n",
    "# The whole simulation runs in SI units and will output hysterysis plots in SI units (scaled appropriately)\n",
    "#\n",
    "# The aim of this program is to create a hysterysis loop to extract atomic magnetic moment mi of sample\n",
    "#\n",
    "# The calculations follow the WEEK 9 tab or the SIGNAL FLOW tab in the google doc\n",
    "\n",
    "'''\n",
    "THE PLAN \n",
    "1. Import libraries required such as numpy, mapplotlib, scipy\n",
    "2. Define Variables:\n",
    "    - N_el: number of turns in electromagnet coil\n",
    "    - Np: Number of turns in the pickup coil\n",
    "    - l: length of the electromagnet coil\n",
    "    - B(0): background magnetisation\n",
    "    - R: Resistor value (the one in series with the electromagnet coil)\n",
    "    - A: Area of the pickup coil (m^2)\n",
    "    - mu0: vacuum magnetic permeability (SI units)\n",
    "    - V: Volume of the sample\n",
    "    \n",
    "3. Import data from csv (in the same folder)\n",
    "\n",
    "    - - - BEGIN H(t) COMPUTATUION (The electromagnet bit CH2) - - - \n",
    "4. Compute I(t) array from I(t) = V(t) / R\n",
    "5. Compute B(t) array from B(t) = mu0 * I(t) * N / l\n",
    "6. Compute H(t) array from H(t) = B(t) / mu0\n",
    "\n",
    "    - - - BEGIN M(t) COMPUTATION (the pickup coil bit CH1) - - -\n",
    "First we will compute additional array V -> dB/dt\n",
    "7. Create an array dB/dt = - V(t) / (Np * A)\n",
    "6. Call integrate function cumulative_simpsons rule for creating an additional array of B(t) - B(0)\n",
    "7. Create an addittional array which represents B(t) = B(0) - int[V(t)dt]\n",
    "8. Create final array M(t) = (B(t)/mu0) - H(t)\n",
    "9. print mi to screen with mi = M(t) * Volume of sample\n",
    "\n",
    "    - - - PLOT Hysterysis Loop - - -\n",
    "    H(t) vs M(t)\n",
    "'''\n",
    "\" ---- 1. Imports ------------------------------------------------------\"\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.integrate import cumulative_trapezoid\n",
    "from scipy.integrate import cumulative_simpson \n",
    "\n",
    "\" ---- 2. Parameters (edit these) --------------------------------------\"\n",
    "CSV_FILE = \"SDS00001.CSV\"   # same folder as the jupyter notebook file\n",
    "N_el = 366                    # 366 turns in the electromagnet coil\n",
    "L = 0.120                     # length of electromagnet coil [m]  (120 mm)\n",
    "R_pickup = 2.5                # internal impedance of pickup coil\n",
    "R_el = 1.9                    # internal impedance of the electromagnet coil\n",
    "R_added = 100                 # series resistor [ohm] (5 A * 1 ohm = 5 V on CH2; 25 W!)\n",
    "R_tot = R_el                  # Treating the total electromagnet circuit resistance as series might be wrong, so will just use r_added\n",
    "Np = 90                       # 90 turns in the pickup coil +- 5\n",
    "A = 0.000346                  # pickup coil area [m^2]  (1 cm^2) (the Area of the pickup coil)\n",
    "B0 =  0.00005733              # known static background field B(0) [T], Didn't take a measurement this time\n",
    "V_sample = 3.439e-8           # sample volume [m^3] Calculated by weighing sample and using density relation\n",
    "mu0 = 4*np.pi*1E-7            # vacuum permeability 4PI E-7\n",
    "\n",
    "\" ---- 3. Import data --------------------------------------------------\"\n",
    "df = pd.read_csv(CSV_FILE, skiprows=2, header=None, usecols=[3, 4, 5],\n",
    "                  names=[\"Time\", \"CH1\", \"CH2\"])\n",
    "t   = df[\"Time\"].to_numpy(dtype=float)   # time [s]\n",
    "ch1 = df[\"CH1\"].to_numpy(dtype=float)    # pickup coil voltage [V]\n",
    "ch2 = df[\"CH2\"].to_numpy(dtype=float)    # electromagnet resistor voltage [V]\n",
    "t, ch1, ch2 = t[:-4], ch1[:-4], ch2[:-4] # drop last 4 rows (artifact samples) \n",
    "\n",
    "\" ---- BEGIN H(t) COMPUTATION (electromagnet, CH2) ---------------------\"\n",
    "# 4.\n",
    "I = ch2 / R_added                        # [A] (just using the resistor in series)\n",
    "\n",
    "# 5. Field at the centre of the electromagnet coil: B(t) = mu0 * I(t) * N / L\"\n",
    "B_el = mu0 * I * N_el / L              # [T]\n",
    "\n",
    "# 6. Applied field: H(t) = B(t) / mu0\"\n",
    "H = B_el / mu0                         # [A/m]\n",
    "\n",
    "\" ---- BEGIN M(t) COMPUTATION (pickup coil, CH1) -----------------------\"\n",
    "# 7. Convert voltage to dB/dt: dB/dt = -V(t) / (Np * A)\n",
    "\n",
    "dB_dt = -ch1 / (Np * A)                # [T/s]\n",
    "\n",
    "# 8. Integrate dB/dt over time: gives B(t) - B(0)\n",
    "#    (swap in cumulative_trapezoid if you want to compare the two methods)\n",
    "#B_minus_B0 = cumulative_trapezoid(dB_dt, x=t, initial=0)   # [T]\n",
    "B_minus_B0 = cumulative_simpson(dB_dt, x=t, initial=0)   # Comment line above and uncomment this to try it out\n",
    "\n",
    "# 9. Add the background: B(t) = B(0) + [B(t) - B(0)]\n",
    "B = B0 + B_minus_B0                    # [T]\n",
    "\n",
    "# 10. Magnetisation: M(t) = B(t)/mu0 - H(t)\n",
    "M = B / mu0 - H                        # [A/m]\n",
    "M_corrected = -M                       # I think the pickup coil polarity is reversed so corrected value here\n",
    "\n",
    "# 11. Moment of the sample: take M where the loop crosses H = 0\n",
    "j = np.argmin(np.abs(H))               # finds the index of the abs value of H element that is closest to 0\n",
    "M_at_H0 = -M[j]                        # [A/m] Finds the M of the same index (had to change sign to get hysteresis loop oriented correctly)\n",
    "mi = M_at_H0 * V_sample                # [A m^2] mi individual magnetic moment\n",
    "print(\"M at H = 0 :\", M_at_H0, \" A/m\")\n",
    "print(\"Sample moment mi = \" ,mi, \"A m^2\")\n",
    "\n",
    "\" ---- PLOT Hysteresis loop: M vs H ------------------------------------\"\n",
    "plt.plot(H, M_corrected)                        # Had to change sign of M to get hysteresis loop oriented correctly\n",
    "plt.plot(H[j], M_at_H0, \"ro\", label=\"M at H = 0\")\n",
    "plt.axhline(0, color=\"black\", lw = 0.5)\n",
    "plt.axvline(0, color=\"black\", lw=0.5)\n",
    "plt.xlabel(\"H (A/m)\")\n",
    "plt.ylabel(\"M (A/m)\")\n",
    "plt.title(\"Hysteresis loop\")\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "plt.show()\n",
    "\n",
    "\" ---- PLOT Both Ch1 and Ch2 vs Time ------------------------------------\"\n",
    "fig, ax = plt.subplots(2, 1, sharex=True, figsize=(8, 5))\n",
    "ax[0].plot(t, ch1)\n",
    "ax[0].set_ylabel(\"CH1 (V) — pickup\")\n",
    "ax[1].plot(t, ch2)\n",
    "ax[1].set_ylabel(\"CH2 (V) — electromagnet\")\n",
    "ax[1].set_xlabel(\"Time (s)\")\n",
    "plt.show()\n",
    "\n",
    "\" ---- PLOT 256 Sampled Ch1 vs Ch2 ------------------------------------\"\n",
    "plt.plot(ch1, ch2)\n",
    "plt.axhline(0, color=\"black\", lw = 0.5)\n",
    "plt.axvline(0, color=\"black\", lw=0.5)\n",
    "plt.xlabel(\"CH1, Pickup (V)\")\n",
    "plt.ylabel(\"CH2, Electromagnet Coil (V)\")\n",
    "plt.title(\"256 Sampled Ch1 vs Ch2\")\n",
    "plt.grid()\n",
    "plt.show()\n"
   ]
